@{
}

@model MVCBasicsAssignment1.Models.Temperature

<h1>Temperature</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Fever" method="post">
            <div class="form-group">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <label asp-for="Celsius" class="control-label"></label>
                <input asp-for="Celsius" class="form-control" type="number" step="1.0" value="37.0" />
                <span asp-validation-for="Celsius" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="fahrenheit" class="control-label"></label>
                <p>@ViewBag.fahrenheit</p>
            </div>
            <div class="form-group">
                <label asp-for="Kelvin" class="control-label"></label>
                <p>@ViewBag.kelvin</p>
            </div>
            <div class="form-group">
                <input type="submit" value="Check fever" class="btn btn-primary" />
            </div>
            <div class="alert alert-light border result-box mb-0">
                <p>@ViewBag.Message</p>
            </div>
        </form>
    </div>
</div>