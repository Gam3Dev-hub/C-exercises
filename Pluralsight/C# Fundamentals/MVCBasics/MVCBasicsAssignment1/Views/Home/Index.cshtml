@model IEnumerable<MVCBasicsAssignment1.Models.Book>
@{
    ViewData["Title"] = "Home Page";
}

<div class="container">
	<div class="row-md-4">
		<div class="col-md-4">
			<h3>Favorite books</h3>
		</div>
		<div class="col-md-4">
			<a asp-controller="Book" asp-action="Create" class="btn btn-primary">Add Book</a>
		</div>
	</div>

</div>

 
<div>
	@foreach (var book in Model)
	{
		<partial name="_BooksPartial" model="book" />
	}

</div> 